{
  "name": "backend",
  "version": "4.0.0",
  "description": "Eather WETH/USDC trading bot (Uniswap v3, Polygon)",
  "main": "botRunner.js",
  "scripts": {
    "bot": "node botRunner.js",
    "sim": "node botSimRunner.js",
    "backtest": "node bot/backtest.js",
    "scan": "node bot/scanner.js",
    "backtest:underwater": "node bot/backtestUnderwater.js",
    "sim:breakeven": "node botSimRunner.js --live --chain polygon --mode breakeven",
    "sim:instant": "node botSimRunner.js --live --chain polygon --mode instant",
    "sim:timestop": "node botSimRunner.js --live --chain polygon --mode timestop",
    "sim:regime": "node botSimRunner.js --live --chain polygon --mode regime",
    "sim:compare": "node bot/simCompare.js",
    "sim:base:breakeven": "node botSimRunner.js --live --chain base --mode breakeven",
    "sim:base:instant": "node botSimRunner.js --live --chain base --mode instant",
    "sim:base:timestop": "node botSimRunner.js --live --chain base --mode timestop",
    "sim:base:regime": "node botSimRunner.js --live --chain base --mode regime",
    "deploy:env": "node deploy/make-server-env.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.8.4",
    "dotenv": "^16.5.0",
    "ethers": "^6.13.5",
    "mongoose": "^8.13.1",
    "ws": "^8.18.0"
  }
}
