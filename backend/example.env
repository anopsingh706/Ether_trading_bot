# ── example.env ──────────────────────────────────────────────────────────────
# Template for the Eather WETH/USDC trading bot.
# Copy this to `backend/.env` and fill in your own values. NEVER commit the real .env.

PORT=5000

# MongoDB. The bot derives its own sandbox DB (→ jan25au_botsim) from DB_URL,
# or set BOT_DB_URL explicitly.
DB_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/your_db"
# BOT_DB_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/jan25au_botsim"

# Wallet that signs Uniswap swaps on Polygon — KEEP SECRET
PRIVATE_KEY=your_wallet_private_key_here
ADMIN_WALLET_ADDRESS=0xYourWalletAddressHere

# Polygon RPC (Infura / Alchemy). A 2nd endpoint is used as fallback.
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
POLYGON_RPC_URL_2=https://polygon-mainnet.infura.io/v3/YOUR_BACKUP_KEY

# Tokens (Polygon). Note: USDT_TOKEN_ADDRESS here is actually USDC.e (what the wallet holds).
WETH_TOKEN_ADDRESS=
USDT_TOKEN_ADDRESS=

CRYPTO_ID=ETHUSDT

# Binance (price sanity check / scanner) — KEEP SECRET
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ── Price source (Polygon Uniswap v3) ──
BOT_PRICE_SOURCE=uniswap        # decisions + execution on the real pool
BOT_POOL_FEE=500                # 0.05% tier — deepest WETH/USDC.e pool (feeScan.js proves it's the cost floor)

# ── Strategy: trailing-reversal on an EMA-smoothed price ──
BOT_THRESHOLD_MODE=absolute     # entry/exit are fixed $ amounts
BOT_ENTRY_THRESHOLD=3           # BUY when smoothed price rises $3 off the low
BOT_EXIT_THRESHOLD=4            # SELL when smoothed price falls $4 off the high (give trends room)
BOT_SMOOTHING=true              # decide on a smoothed (EMA) price, not raw ticks
BOT_SMOOTHING_MS=30000          # EMA time-constant ≈ 30s

# ── Trend filter (Option B) — superseded by the regime gate below; kept off ──
BOT_TREND_FILTER=false
BOT_TREND_EXIT=false
BOT_TREND_WINDOW_MS=900000      # 15-min MA window (shared by trend filter + regime slope)
BOT_TREND_MIN_SAMPLES=20        # warm-up ticks before trend/regime act

# ── Regime / chop gate (anti-whipsaw) — only BUY when actually trending up ──
BOT_REGIME_FILTER=true
BOT_REGIME_MIN_SLOPE_PCT=0.2    # 15-min MA must have risen ≥ this % to count as a real trend

# ── Protective exits / guards ──
BOT_STOP_LOSS_PCT=0.5           # cut a long if price falls ≥0.5% below entry
BOT_MIN_NET_PROFIT=0            # 0 = let the tight exit also cut failed bounces
BOT_EST_COST=0.04
BOT_SLIPPAGE_HALT=true
BOT_SLIPPAGE_BPS=50
BOT_SLIPPAGE_TOLERANCE=0.005    # 0.5% min-output protection on every live swap

# ── Anti-churn ──
BOT_ENTRY_CONFIRM_MS=0          # fake-spike time-confirm (0 = off; it chased the move when on)
BOT_COOLDOWN_MS=300000          # 5-min re-entry cooldown (entry-only; never blocks a protective SELL)

# ── Volume confirmation (false-breakout filter; Binance kline WS, no RPC load) ──
BOT_VOLUME_FILTER=true
BOT_VOLUME_MULT=1.5             # latest candle vol must be ≥ 1.5× the trailing MA
BOT_VOLUME_WINDOW=20            # volume MA length (candles)
BOT_VOLUME_MIN_SAMPLES=5        # candles before the filter activates (also REST-seeded on startup)
BOT_VOLUME_SYMBOL=ethusdt
BOT_VOLUME_INTERVAL=5m          # 5m confirms a sustained move, not a 1-min blip

# ── RPC load throttle (keep — prevents Infura rate-limit crash) ──
BOT_BLOCK_POLL_MS=8000
BOT_FEED_MIN_READ_MS=4000
BOT_USE_WSS=false               # off = poll-only price (drops the per-block WSS subscription; big RPC saving)
BOT_RPC_BACKOFF_MS=30000        # pause this long after an RPC error instead of retrying every tick
