# ── example.env ──────────────────────────────────────────────────────────────
# Template for the Eather WETH/USDC trading bot.
# Copy this to `backend/.env` and fill in your own values. NEVER commit the real .env.

PORT=5000

# MongoDB. The bot derives its own sandbox DB (→ jan25au_botsim) from DB_URL,
# or set BOT_DB_URL explicitly.
DB_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/your_db"
# BOT_DB_URL="mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/jan25au_botsim"

# Wallet that signs Uniswap swaps on Polygon — KEEP SECRET
PRIVATE_KEY=your_wallet_private_key_here
ADMIN_WALLET_ADDRESS=0xYourWalletAddressHere

# Polygon RPC (Infura / Alchemy). A 2nd endpoint is used as fallback.
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_KEY
POLYGON_RPC_URL_2=https://polygon-mainnet.infura.io/v3/YOUR_BACKUP_KEY

# Tokens (Polygon) — REQUIRED. Note: USDT_TOKEN_ADDRESS here is actually USDC.e
# (what the wallet holds). Canonical addresses are listed in docs/PROJECT_STATUS.md §6.
WETH_TOKEN_ADDRESS=
USDT_TOKEN_ADDRESS=

CRYPTO_ID=ETHUSDT

# Binance (price sanity check / scanner) — KEEP SECRET
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret

# ══ Strategy (mirrors the live config as of 2026-07-02) ═══════════════════════
BOT_PRICE_SOURCE=uniswap    # decide AND trade on the same Uniswap v3 pool
BOT_POOL_FEE=500            # 0.05% tier (the liquid WETH/USDC.e pool on Polygon)
BOT_THRESHOLD_MODE=absolute
BOT_ENTRY_THRESHOLD=5       # BUY on a $5 raw rise off the low ($1 was noise-level)
BOT_EXIT_THRESHOLD=3        # trailing exit $3 below the peak (above break-even only)
BOT_SMOOTHING=false         # decisions on RAW pool ticks (no EMA)
BOT_SMOOTHING_MS=30000      # (ignored while BOT_SMOOTHING=false)

# Exit mode: 'breakeven' = NEVER sell at a small loss — hold underwater until price
# recovers to break-even (entry+fees+gas+buffer), then exit BE-or-better; the ONLY
# realizable loss is the deep disaster stop. 'classic' = trailing exit + 0.5% stop.
BOT_EXIT_MODE=breakeven
BOT_DISASTER_STOP_PCT=5     # bounded catastrophe valve; 0 = never lose (NOT advised: 30d test froze 719h at −17% unrealized)
BOT_BE_BUFFER_PCT=0.1       # margin above true breakeven so BE exits net ≥ 0 after gas
BOT_STOP_LOSS_PCT=0.5       # used by 'classic' exit mode only

# Entry gates
BOT_TREND_FILTER=true       # adaptive downtrend guard: only BUY when price ≥ 15-min MA
BOT_TREND_EXIT=false        # keep off (history: insta-sold bounce buys)
BOT_VOLUME_FILTER=true      # only BUY with volume behind the move (spike-aware: live candle counts)
BOT_VOLUME_MULT=1.5
BOT_VOLUME_WINDOW=20
BOT_VOLUME_MIN_SAMPLES=5
BOT_VOLUME_SYMBOL=ethusdt
BOT_VOLUME_INTERVAL=1m
BOT_ATR_FILTER=false        # OFF: closed-candle ATR lags sudden spikes (ATR still feeds adaptive slippage)
BOT_ATR_PERIOD=14
BOT_ATR_MIN_PCT=0.12

# Guards / economics
BOT_MIN_NET_PROFIT=0
BOT_EST_COST=0.04

# Swap safety
BOT_SLIPPAGE_HALT=true
BOT_SLIPPAGE_BPS=60         # post-fill alert (0.60%) — must be ≥ the max adaptive minOut below
BOT_SLIPPAGE_TOLERANCE=0.0015  # base minOut buffer (0.15%) in quiet markets
BOT_SLIPPAGE_ATR_MULT=2     # widen minOut with live 1m ATR in fast markets…
BOT_SLIPPAGE_MAX=0.005      # …capped at 0.50%
BOT_REVERT_BACKOFF_MS=60000 # after a reverted swap, wait 60s (reverts still burn gas)

# Option A (fake-spike confirm + cooldown) — OFF
BOT_ENTRY_CONFIRM_MS=0
BOT_COOLDOWN_MS=0

# RPC load throttle (keep — prevents rate-limit crashes) + WSS block subscription
BOT_USE_WSS=true
BOT_BLOCK_POLL_MS=8000
BOT_FEED_MIN_READ_MS=2000

# ── Simulation mode (npm run sim — no wallet / no real funds needed) ──────────
BOT_SIM_CAPITAL=1000        # virtual USDC starting balance
BOT_SIM_TX_TARGET=1000      # progress display target
BOT_SIM_MAX_TX=0            # hard stop after N swaps (0 = run until stopped)
